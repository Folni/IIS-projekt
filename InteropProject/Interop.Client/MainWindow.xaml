<Window x:Class="Interop.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Interop Klijentska Aplikacija" Height="750" Width="950"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F0F2F5" Padding="10" CornerRadius="5" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Korisničko ime:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="TxtUsername" Width="100" Text="admin" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Lozinka:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <PasswordBox x:Name="TxtPassword" Password="admin123" Width="100" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="BtnLogin" Content="Prijava (JWT)" Click="BtnLogin_Click" Padding="10,4" Margin="0,0,15,0"/>
                <TextBlock x:Name="TxtRoleStatus" Text="Status: Niste prijavljeni" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1">

            <TabItem Header="Cosmic &amp; Baza (REST)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <Button Content="Učitaj s Cosmic API" Click="BtnGetCosmic_Click" Padding="10,5" Margin="0,0,10,0"/>
                        <Button Content="Učitaj iz Baze" Click="BtnGetDb_Click" Padding="10,5"/>
                    </StackPanel>

                    <DataGrid x:Name="DgArticles" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="120"/>
                            <DataGridTextColumn Header="Naslov" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="Slug" Binding="{Binding Slug}" Width="150"/>
                            <DataGridTextColumn Header="Sažetak / Sadržaj" Binding="{Binding Summary}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Validacija &amp; Unos (CRUD)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="CRUD Upravljanje Člancima" Grid.Row="0" Margin="0,0,0,10" Padding="10">
                        <StackPanel>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Naslov:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox x:Name="TxtCrudTitle" Grid.Column="1" Margin="0,0,15,0"/>
                                <TextBlock Text="Slug:" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox x:Name="TxtCrudSlug" Grid.Column="3"/>
                            </Grid>

                            <Grid Margin="0,5,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Sadržaj:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox x:Name="TxtCrudContent" Grid.Column="1"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button x:Name="BtnCrudCreate" Content="Dodaj (Create)" Click="BtnCrudCreate_Click" Width="110" Padding="5" Margin="0,0,5,0"/>
                                <Button x:Name="BtnCrudUpdate" Content="Ažuriraj (Update)" Click="BtnCrudUpdate_Click" Width="110" Padding="5" Margin="5,0"/>
                                <Button x:Name="BtnCrudDelete" Content="Obriši (Delete)" Click="BtnCrudDelete_Click" Width="110" Padding="5" Margin="5,0,0,0" Background="#FFFDEDED"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <DataGrid x:Name="DgCrud" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DgCrud_SelectionChanged" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="120"/>
                            <DataGridTextColumn Header="Naslov" Binding="{Binding Title}" Width="150"/>
                            <DataGridTextColumn Header="Slug" Binding="{Binding Slug}" Width="150"/>
                            <DataGridTextColumn Header="Sadržaj" Binding="{Binding Content}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="JSON Validacija" Grid.Column="0" Margin="0,0,5,0">
                            <DockPanel Margin="5">
                                <Button x:Name="BtnSendJson" DockPanel.Dock="Bottom" Content="Pošalji JSON" Click="BtnSendJson_Click" Padding="5" Margin="0,5,0,0"/>
                                <TextBox x:Name="TxtJsonInput" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="XML Validacija" Grid.Column="1" Margin="5,0,0,0">
                            <DockPanel Margin="5">
                                <Button x:Name="BtnSendXml" DockPanel.Dock="Bottom" Content="Pošalji XML" Click="BtnSendXml_Click" Padding="5" Margin="0,5,0,0"/>
                                <TextBox x:Name="TxtXmlInput" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </DockPanel>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="SOAP (XPath Pretraga)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Pojam:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="TxtSoapSearch" Width="200" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="Traži preko SOAP-a" Click="BtnSoapSearch_Click" Padding="10,5"/>
                    </StackPanel>

                    <DataGrid x:Name="DgSoapResults" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                            <DataGridTextColumn Header="Naslov" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="Slug" Binding="{Binding Slug}" Width="150"/>
                            <DataGridTextColumn Header="Autor" Binding="{Binding Metadata.Author}" Width="120"/>
                            <DataGridTextColumn Header="Kategorija" Binding="{Binding Metadata.Category}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="gRPC Prognoza (DHMZ)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Grad:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="TxtGrpcCity" Width="150" Text="Zagreb" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="Dohvati DHMZ Temperaturu" Click="BtnGrpc_Click" Padding="10,5"/>
                    </StackPanel>
                    <DataGrid x:Name="DgGrpcResults" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True"/>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>